{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrape",
  "version": "0.1.0",
  "identifier": "dev.scrape.app",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SCRAPE",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/scrape-worker"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldSYkhZTEZ4NkJkR05kZzVVR2Z2eWdKdzV4Z3V0WnFscXBhbGNqS01YVnIK",
      "endpoints": [
        "https://github.com/samir-scripts/scrape/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
